# Copy to .env and fill in. Any OpenAI-compatible endpoint works:
#   OpenAI:     https://api.openai.com/v1        model: gpt-4o-mini
#   OpenRouter: https://openrouter.ai/api/v1     model: deepseek/deepseek-chat
#   Ollama:     http://localhost:11434/v1        model: llama3.1
#   LM Studio:  http://localhost:1234/v1         model: <your loaded model>

OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
# The model accepts images too (default). Set to text for models without vision.
# LLM_INPUT_TYPES=text,image
# Optional faster/cheaper model for background email triage & watcher checks:
# FAST_MODEL=gpt-4o-mini

# Port for the web UI + API
PORT=8787

# Optional: name your assistant & set your city (used for proactive event & plan suggestions)
ASSISTANT_NAME=Pond
# USER_LOCATION=San Francisco, CA

# Proactive (Muse-style always-on daily chief-of-staff)
PROACTIVE_ENABLED=true
PROACTIVE_AGGRESSIVENESS=high          # low | medium | high | aggressive
PROACTIVE_INTERVAL_MINUTES=3           # how often Pond wakes up to scan & act
PROACTIVE_MIN_GAP_MINUTES=5            # minimum gap between general check-ins (urgent alerts bypass this)
MAX_TOOL_ROUNDS=100                    # max tool-call rounds per chat reply (was 10)
PROACTIVE_DND_HOURS=4                  # within N hours of the last check-in, stay silent unless something is actionable (0 = off)
# PROACTIVE_QUIET_HOURS=23:00-07:00    # optional quiet hours (critical alerts still fire)
PROACTIVE_AUTO_TASKS=true              # autonomously advance open to-dos & research tasks
PROACTIVE_BRIEFINGS=true               # morning / midday / evening briefings & event ideas
REMINDER_HEADSUP_MINUTES=15            # heads-up notification before reminders

# Email Monitor (IMAP incoming + optional SMTP outgoing; can also be configured in the UI Settings!)
# For Gmail: enable 2FA and create an App Password, use imap.gmail.com:993 & smtp.gmail.com:465
# EMAIL_ENABLED=true
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=you@gmail.com
# IMAP_PASS=your-app-password
# IMAP_TLS=true
# IMAP_MAILBOX=INBOX
# EMAIL_POLL_INTERVAL_MINUTES=10
# EMAIL_VIP_SENDERS=boss@company.com,mom@example.com
# EMAIL_IMPORTANT_KEYWORDS=urgent,asap,invoice,payment,security,verify,flight,booking,interview,offer,deadline,action required,delivery

# Optional SMTP for sending replies (always protected by Sentinel approval before sending!)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_SECURE=true
# EMAIL_FROM=you@gmail.com

# Optional Calendar iCal (.ics) feed (Google Calendar / Apple / Outlook secret iCal URL)
# CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics
EVENT_REMINDER_MINUTES=30

# Sentinel out-of-band permission gate for sensitive actions (sending email, deleting files, etc.)
SENTINEL_ENABLED=true
SENTINEL_TIMEOUT_SEC=300

# Optional webhook auth secret for POST /api/webhooks/<source>
# WEBHOOK_SECRET=change-me

# Sandboxed root for file tools. Default: ~/Documents
# POND_FS_ROOT=C:\Users\you\Documents
# Folder served at /share/ so AI-made files open on every device (default: <file root>/Pond Share)
# POND_SHARE_DIR=

# Web search backend: auto | deepseek | bing
SEARCH_BACKEND=auto
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
# DEEPSEEK_SEARCH_MODEL=deepseek-v4-flash

# Web Push: contact sent to push services in the VAPID token (Apple prefers a real address)
# PUSH_CONTACT=you@example.com

# ---- Personality & appearance (also editable in Agent Hub → Appearance) ----
# PERSONA=default                      # default | casual | concise | playful | custom
# PERSONA_CUSTOM=Talk like a laid-back friend. Keep replies short.
# MASCOT_PALETTE=cyan                  # cyan | teal | mint | violet | pink | coral | ink | custom
# MASCOT_COLOR=#22c3e6                 # body color when MASCOT_PALETTE=custom
# USER_LOCATION=San Francisco, CA      # used for local suggestions
